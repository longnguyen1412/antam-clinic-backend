# Configuration cho Site Trung tâm (S0)
PORT=8082
NODE_ENV=development

# Site Identification S0 (Trung tâm quản trị)
SITE_CODE=S0
SITE_NAME=Trung tâm

# Database PostgreSQL Hub S0
DB_HOST=localhost
DB_PORT=5430
DB_NAME=ql_phongkham_hub
DB_USER=admin
DB_PASS=password123

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000

# Central MongoDB & Kafka Configuration (Chạy tại máy Trung tâm S0)
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=antam_clinic_analytics
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=antam-clinic-backend
KAFKA_GROUP_ID=antam-analytics-worker

