# Configuration cho Chi nhánh Cầu Giấy (S1)
PORT=8082
NODE_ENV=development

# Site Identification S1 (Chi nhánh)
SITE_CODE=S1
SITE_NAME=Chi nhánh Cầu Giấy

# Database PostgreSQL Branch S1
DB_HOST=localhost
DB_PORT=5431
DB_NAME=ql_phongkham_cn1
DB_USER=admin
DB_PASS=password123

# Connection Pool Settings
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONN_TIMEOUT_MS=5000

# Central Kafka (Chi nhánh gửi events về Kafka đặt tại Site Trung tâm S0)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=antam-clinic-backend

