# Server Configuration
PORT=8080
NODE_ENV=development

# Multi-site PostgreSQL Configuration
# Site S0 (Hub - Trạm Trung tâm)
DB_S0_HOST=localhost
DB_S0_PORT=5430
DB_S0_NAME=ql_phongkham_hub
DB_S0_USER=admin
DB_S0_PASS=password123

# Site S1 (Branch 1 - Chi nhánh Cầu Giấy)
DB_S1_HOST=localhost
DB_S1_PORT=5431
DB_S1_NAME=ql_phongkham_cn1
DB_S1_USER=admin
DB_S1_PASS=password123

# Site S2 (Branch 2 - Chi nhánh Đống Đa)
DB_S2_HOST=localhost
DB_S2_PORT=5432
DB_S2_NAME=ql_phongkham_cn2
DB_S2_USER=admin
DB_S2_PASS=password123

# Site S3 (Branch 3 - Chi nhánh Ba Đình)
DB_S3_HOST=localhost
DB_S3_PORT=5433
DB_S3_NAME=ql_phongkham_cn3
DB_S3_USER=admin
DB_S3_PASS=password123

# Default Site if not specified in X-Site header
DEFAULT_SITE=S1
